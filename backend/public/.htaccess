# Toutes les requêtes vers ce dossier sont traitées par index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Indispensable chez Ionos (sinon erreur 500 sur toute adresse réécrite)
    RewriteBase /api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
